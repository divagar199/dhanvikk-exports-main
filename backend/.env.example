PORT=5000
NODE_ENV=production
CLIENT_URL=https://dhanvikk-exports-main.vercel.app

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dhanvikk_blooms?retryWrites=true&w=majority

# Security & Session Secrets
JWT_SECRET=your_production_secure_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_production_secure_cookie_secret_key
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Razorpay Payment Gateway Credentials (Obtained from Razorpay Dashboard)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_key

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Firebase Service Account (JSON string or base64 encoded for server verification)
FIREBASE_SERVICE_ACCOUNT_KEY=

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@yourdomain.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM="Dhanvikk Blooms <orders@yourdomain.com>"
