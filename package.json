{
  "name": "dhanvikk-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dhanvikk Blooms & Exports - E-Commerce Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "node scripts/build-frontend.js",
    "start:backend": "npm run start --prefix backend",
    "seed:catalog": "python backend/scripts/build_final_products_files.py",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "test": "node scripts/run-all-tests.js",
    "test:backend": "node --test backend/tests/api.test.js",
    "test:mobile": "node --test mobile/tests/mobile.test.mjs",
    "test:frontend": "node --test frontend/tests/frontend.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true
  }
}
