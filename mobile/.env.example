# =============================================================================
# Dhanvikk Blooms Mobile — Expo Environment Variables Template
# Copy this to .env and fill in your real values.
# NEVER commit .env to source control.
# =============================================================================

# ── Backend API ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://dhanvikk-exports-api.onrender.com

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Android app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google Sign-In ─────────────────────────────────────────────────────────────
# Web Client ID from: Google Cloud Console → APIs & Services → Credentials
# (type = "Web application" — NOT the Android client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<sender-id>-<hash>.apps.googleusercontent.com
