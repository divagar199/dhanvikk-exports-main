# Dhanvikk Blooms & Exports Mobile App Environment Configuration
# API URL (Default production backend; use http://10.0.2.2:5000 for local Android emulator, or adb reverse)
EXPO_PUBLIC_API_URL=https://dhanvikk-exports-api.onrender.com

# Razorpay Client Key ID (Safe public key for client-side checkout)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Google OAuth Web Client ID (for Google Sign-In authentication)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Google Maps API Key (Optional for delivery hub visualization)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
